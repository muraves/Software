# Configuration files shipped with muraves_lib (see muraves_lib/configuration/README.md).
# The reconstruction parameters are always the shared + data files of this checkout:
# the scripts load them from muraves_lib themselves. Use reco_override_file to change values.
CONFIGURATION_DIR = '../../muraves_lib/configuration'
RECO_PARAMETERS_FILES = [
    f'{CONFIGURATION_DIR}/shared/reco_parameters.json',
    f'{CONFIGURATION_DIR}/data/data_parameters.json',
]
RECO_OVERRIDE_FILE = EXEC_CFG.get('reco_override_file', '')
RECO_OVERRIDE_ARG = f'--config {RECO_OVERRIDE_FILE}' if RECO_OVERRIDE_FILE else ''
SPIROC_MAPPING_FILE = EXEC_CFG.get('spiroc_mapping_file', f'{CONFIGURATION_DIR}/data/electronics_mapping/spiroc-hybrid-map.cfg')
TELESCOPE_CFG_TEMPLATE = EXEC_CFG.get('telescope_cfg_template', f'{CONFIGURATION_DIR}/data/electronics_mapping/telescope{{color}}.cfg')
PEDESTAL_BENCHMARK_TEMPLATE = EXEC_CFG.get('pedestal_benchmark_template', f'{CONFIGURATION_DIR}/data/pedestal_1phe_values/{{color}}_PED_BANCHMARK')

# Reconstruction parameters (same files and same merge rule as muraves_lib.reco.reco_config,
# which cannot be imported here: the Snakemake submission environment does not have muraves_lib).
def _deep_merge(base, override):
    merged = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = _deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged

def load_reco_parameters():
    import json
    parameters = {}
    for path in RECO_PARAMETERS_FILES:
        with open(path) as handle:
            parameters = _deep_merge(parameters, json.load(handle))
    if RECO_OVERRIDE_FILE:
        with open(RECO_OVERRIDE_FILE) as handle:
            parameters = _deep_merge(parameters, json.load(handle))
    return parameters

RECO_PARAMETERS = load_reco_parameters()
N_BOARDS = int(RECO_PARAMETERS['electronics']['n_boards'])
N_CHANNELS = int(RECO_PARAMETERS['electronics']['n_channels'])
CLUSTER_SMEARING_SEED = config.get('cluster_smearing_seed', None)
SLOW_CONTROL_PREFIX = config.get('slow_control_prefix', 'SLOWCONTROL_run')
if config['run']:
    runs = parse_runs(config['run'])  # convert config file format into list of runs.
    BATCHES = list(batch_runs(runs, BATCH_SIZE))  # # create batches: [[2500,2501,2502], [2503,2504,2505], ...]
    BATCH_IDX = range(len(BATCHES))
else:
    BATCH_IDX = parse_batch_indices(config['batch_idx'])
